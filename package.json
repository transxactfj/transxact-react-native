{
  "name": "@transxact/react-native",
  "version": "0.1.0",
  "description": "React Native hooks and components for Transxact hosted Checkout Sessions",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "transxact-react-native-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @transxact/react-native-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "check:pack": "node scripts/check-pack.mjs",
    "ci": "yarn typecheck && yarn test && yarn prepare && yarn check:pack",
    "changeset": "changeset",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "transxact",
    "react-native",
    "expo",
    "payments",
    "checkout",
    "fiji",
    "mpaisa",
    "mycash"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transxactfj/transxact-react-native.git"
  },
  "author": "Paul Holmes <136897411+phfj@users.noreply.github.com> (https://github.com/phfj)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/transxactfj/transxact-react-native/issues"
  },
  "homepage": "https://github.com/transxactfj/transxact-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "del-cli": "^8.0.1",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.2",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "transxact-react-native-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "jest"
    ],
    "version": "0.64.0"
  },
  "resolutions": {
    "babel-plugin-syntax-hermes-parser": "0.36.1"
  }
}
